# 環境設定・秘密情報
.env
.streamlit/secrets.toml

# 大容量DBファイル（除外）
cogni_code_master.db
partslink_items.db
*.db

# Pythonキャッシュ
__pycache__/
*.py[cod]
*.pyo

# 開発用一時ファイル
tmp_*.py
tmp_*.txt
*.log
*.log.*
dump*.py
dump*.txt
check_*.py
debug_*.txt
test_*.py
step*.py
fix_*.py
search_*.py
find_*.py
extract_*.py
analyze_*.py
cogni_*.py
full_analysis_*.py
deploy_hf.py
keys.txt
result.json
match_output*.txt

# tests/ 直下の .py は上の一時ファイルパターンから除外する。
# analyze_*.py に当たって tests/analyze_real_neo.py が commit されず、
# 引き継ぎ書 §6 と tests/README.md が参照するスクリプトが
# リポジトリから丸ごと消えていた（2026-09-10 発見）。
!tests/*.py

# tools/vendor_sync.py の一時フォルダ（取り込み中・失敗時の残骸）
vendor/pdf_to_neo.tmp/
vendor/pdf_to_neo.old/
vendor/pdf_to_neo.failed/

# vendor/pdf_to_neo は files のコミットの写し（tools/vendor_sync.py）。上の一時ファイル・*.db のパターンに関わらず全部追跡する
# （*.DB の参照表・tests/test_*.py・find_*.py が落ちると clone 先でハッシュ照合に落ちて経路が止まる）
!vendor/pdf_to_neo/**
vendor/pdf_to_neo/**/__pycache__/
